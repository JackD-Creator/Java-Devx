APP_PORT=8080
LOG_LEVEL=INFO

# ── Pilih salah satu DB_KIND: postgresql | mariadb | mssql ──────────────────

# PostgreSQL (default)
DB_KIND=postgresql
DB_URL=jdbc:postgresql://localhost:5432/themedb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MariaDB — ganti nilai di atas dengan:
# DB_KIND=mariadb
# DB_URL=jdbc:mariadb://localhost:3306/themedb
# DB_USERNAME=root
# DB_PASSWORD=secret

# MSSQL — ganti nilai di atas dengan:
# DB_KIND=mssql
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=themedb;encrypt=false
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong@Passw0rd

REGISTRY=ghcr.io
REGISTRY_GROUP=enterprise
VERSION=1.0.0-SNAPSHOT
CORS_ALLOWED_ORIGINS=*
