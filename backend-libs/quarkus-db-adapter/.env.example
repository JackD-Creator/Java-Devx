APP_PORT=8081
LOG_LEVEL=INFO

# ── Pilih salah satu DB_KIND: postgresql | mariadb | mssql ──────────────────

# PostgreSQL (default)
DB_KIND=postgresql
DB_URL=jdbc:postgresql://localhost:5432/appdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MariaDB — ganti nilai di atas dengan:
# DB_KIND=mariadb
# DB_URL=jdbc:mariadb://localhost:3306/appdb
# DB_USERNAME=root
# DB_PASSWORD=secret

# MSSQL — ganti nilai di atas dengan:
# DB_KIND=mssql
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=appdb;encrypt=false
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong@Passw0rd

DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_LOG_SQL=false
