APP_PORT=8082
LOG_LEVEL=INFO

# Generate dengan: AesEncryptionService.generateKey()
# Contoh: openssl rand -base64 32
ENCRYPTION_AES_KEY=CHANGE_ME_USE_openssl_rand_base64_32

ENCRYPTION_RSA_KEY_SIZE=2048
# ENCRYPTION_RSA_PUBLIC_KEY=<base64-encoded-public-key>
# ENCRYPTION_RSA_PRIVATE_KEY=<base64-encoded-private-key>

ENCRYPTION_BCRYPT_COST=12

# Set false di production jika tidak perlu REST endpoint
ENCRYPTION_ENDPOINT_ENABLED=true
